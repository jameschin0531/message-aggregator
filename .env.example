# Copy to .env (never commit .env).

# 'fake' = keyword rules, no API calls. 'anthropic' = Claude API (needs ANTHROPIC_API_KEY).
LLM_PROVIDER=fake
ANTHROPIC_API_KEY=
# Haiku first; move to Sonnet only if evaluation says so (docs/11).
LLM_MODEL=claude-haiku-5-5
LLM_EFFORT=low

# Shared secret for the inbox. Required anywhere other than your own machine.
ADMIN_TOKEN=

# 32 bytes, base64, for platform OAuth tokens (Phase B):
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENC_KEY=
